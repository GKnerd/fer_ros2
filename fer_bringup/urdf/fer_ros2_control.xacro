<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!--
    ros2_control overlay for the multipanda-fork franka_hardware
    (franka_hardware::FrankaMultiHardwareInterface).

    Upstream franka_description's franka_arm.ros2_control.xacro targets the
    non-multi franka_hardware/FrankaHardwareInterface, which is NOT registered in
    this workspace and uses a different param/interface contract. We suppress it
    (ros2_control:=false on xacro:franka_robot in fer.xacro) and emit this instead.
    See fer_ros2/TODO.md item 7.

    Contract enforced by FrankaMultiHardwareInterface::on_init:
      hardware params : robot_count, ns<i>, robot_ip<i>   (i = 1 .. robot_count)
      per joint       : exactly 3 command interfaces (effort, position, velocity)
                        exactly 3 state interfaces   (position, velocity, effort)
      joint namespace : get_ns(joint) = substring before the LAST '_' and must
                        equal ns<i>. With joints '<arm_id>_joint1..7' and
                        ns1='<arm_id>', get_ns('fer_joint1') == 'fer'. Holds.

    The cartesian / robot_state / robot_model interfaces are created
    programmatically by the hardware (export_*_interfaces), NOT from the URDF, so
    they must NOT be declared here.
  -->
  <xacro:macro name="fer_ros2_control" params="arm_id robot_ip">
    <ros2_control name="${arm_id}_FrankaMultiHardwareInterface" type="system">
      <hardware>
        <plugin>franka_hardware/FrankaMultiHardwareInterface</plugin>
        <param name="robot_count">1</param>
        <param name="ns1">${arm_id}</param>
        <param name="robot_ip1">${robot_ip}</param>
      </hardware>

      <xacro:macro name="configure_joint" params="joint_name">
        <joint name="${joint_name}">
          <command_interface name="effort"/>
          <command_interface name="position"/>
          <command_interface name="velocity"/>
          <state_interface name="position"/>
          <state_interface name="velocity"/>
          <state_interface name="effort"/>
        </joint>
      </xacro:macro>

      <xacro:configure_joint joint_name="${arm_id}_joint1"/>
      <xacro:configure_joint joint_name="${arm_id}_joint2"/>
      <xacro:configure_joint joint_name="${arm_id}_joint3"/>
      <xacro:configure_joint joint_name="${arm_id}_joint4"/>
      <xacro:configure_joint joint_name="${arm_id}_joint5"/>
      <xacro:configure_joint joint_name="${arm_id}_joint6"/>
      <xacro:configure_joint joint_name="${arm_id}_joint7"/>
    </ros2_control>
  </xacro:macro>
</robot>
