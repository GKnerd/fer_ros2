<root BTCPP_format="4" main_tree_to_execute="ChainedPickPlace">
  <!--
    Chained Pick&Place: pick cylinder_1 and place it at three targets in turn,
    returning home between placements. Mirrors the reference command:

      pick_object {object_id: cylinder_1}
      place_object {object_id: cylinder_1, place_pose: base (0.50,  0.30, 0.05)}
      go_home
      ... repeated for y = -0.30 and y = 0.00

    The Sequence stops at the first failure, exactly like the `&&` chain.
  -->
  <BehaviorTree ID="ChainedPickPlace">
    <Sequence name="chained_pick_place">
      <!-- Target 1: y = +0.30 -->
      <PickObject  object_id="cylinder_1"/>
      <PlaceObject object_id="cylinder_1" frame_id="base" x="0.50" y="0.30" z="0.05"
                   qx="0.0" qy="0.0" qz="0.0" qw="1.0"/>
      <GoHome/>

      <!-- Target 2: y = -0.30 -->
      <PickObject  object_id="cylinder_1"/>
      <PlaceObject object_id="cylinder_1" frame_id="base" x="0.50" y="-0.30" z="0.05"
                   qx="0.0" qy="0.0" qz="0.0" qw="1.0"/>
      <GoHome/>

      <!-- Target 3: y = 0.00 -->
      <PickObject  object_id="cylinder_1"/>
      <PlaceObject object_id="cylinder_1" frame_id="base" x="0.50" y="0.00" z="0.05"
                   qx="0.0" qy="0.0" qz="0.0" qw="1.0"/>
      <GoHome/>
    </Sequence>
  </BehaviorTree>
</root>
