<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>fer_behavior_trees</name>
  <version>0.0.0</version>
  <description>Behavior trees of the FER platform: one node per fer_interfaces interface, Pick and Place subtrees and the PickPlace tree, served by fer_bt_server.</description>
  <maintainer email="georg.katranis@gmail.com">georg.katranis@gmail.com</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>behaviortree_cpp</depend>
  <depend>behaviortree_ros2</depend>
  <depend>fer_interfaces</depend>
  <depend>geometry_msgs</depend>
  <!-- Old server; removed in 8.7. -->
  <depend>control_msgs</depend>
  <depend>fer_skills</depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_cmake_ros</test_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
